root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
max_line_length = 100
tab_width = 4

[*.{md,nix,ui,xml,yaml,yml}]
indent_size = 2
indent_style = space

[meson.build]
indent_size = 4
indent_style = space
max_line_length = 100
